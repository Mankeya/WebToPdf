{
  "name": "webtopdf",
  "version": "1.6.2",
  "private": true,
  "description": "Extensão local para converter páginas web em PDF com prévia e ajustes de impressão.",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "brand:extract": "node scripts/extract-brand.mjs",
    "package": "node scripts/package.mjs",
    "package:store": "node scripts/package.mjs --store",
    "publish:store": "node scripts/publish-store.mjs",
    "store:screenshots": "npm run build && node scripts/store-screenshots.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:workspace": "node scripts/check-workspace.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:check": "node scripts/release-check.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.6",
    "@types/node": "^26.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^5.1.1"
  }
}
