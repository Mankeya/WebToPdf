{
  "manifest_version": 3,
  "name": "WEBtoPDF — Desenvolvimento",
  "description": "Estrutura inicial para conversão local de páginas em PDF com prévia.",
  "version": "0.1.0",
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir WEBtoPDF (estrutura inicial)"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
